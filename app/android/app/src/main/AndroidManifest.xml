<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app talks to the PharmaGuard API over the network. This is the only
         permission it needs: no storage, camera, location or contacts. The file
         picker uses the system document picker, which hands back bytes without
         granting us storage access. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Not required, but lets the app fail fast with a useful message when the
         device is offline instead of waiting out a connection timeout. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- android:usesCleartextTraffic="false"
             The deployed API is HTTPS-only, so plaintext HTTP is refused
             outright. This also stops an on-path attacker downgrading a request
             that carries a patient's genotype data. Local development against
             http://localhost:8000 is exempted in network_security_config.xml —
             cleartext to a loopback address never leaves the device.

         android:allowBackup="false"
             Nothing this app holds belongs in a cloud device backup; the only
             interesting data is the VCF the user just picked. -->
    <application
        android:label="PharmaGuard"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
