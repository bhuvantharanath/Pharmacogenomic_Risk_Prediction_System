# --- Secrets ---------------------------------------------------------------
# .env.example is committed; .env never is.
.env
*.env
!.env.example

# --- Python ----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Flutter / Dart --------------------------------------------------------
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
# pubspec.lock IS committed for applications — it pins the exact dependency set.

# --- Android / iOS ---------------------------------------------------------
app/android/.gradle/
app/android/local.properties
app/android/app/debug/
app/android/app/release/
app/ios/Pods/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/ephemeral/
app/ios/.symlinks/
*.iml

# --- Editors / OS ----------------------------------------------------------
.idea/
.vscode/
.DS_Store

# --- Phase 2/3 -------------------------------------------------------------
# The PharmCAT JAR is large and is fetched at image-build time, not committed.
*.jar
# Vector store artefacts built from /rag-corpus.
rag-corpus/.index/

# --- Phase 2: PharmCAT local install (not committed; see infra/PHARMCAT_NOTES.md) ---
backend/pharmcat/
backend/definitions/
pharmcat-*.tar.gz
pharmcat_positions*.vcf*

# PharmCAT writes this into the working directory when it runs.
pharmcat.log

# --- Phase 3 ---------------------------------------------------------------
# Guard violation log: generated at runtime, useful locally, not source.
backend/logs/
# Extracted PharmCAT allele definitions used by the synthetic VCF generator.
definitions/

# --- Phase 4: deployment ----------------------------------------------------
# Android release signing. The keystore IS the signing identity and
# key.properties holds its passwords in plaintext. Never commit either.
key.properties
*.jks
*.keystore
# Flutter build output.
app/build/
# Wrangler / Cloudflare local state.
.wrangler/

# --- Phase 5A ---------------------------------------------------------------
# Guard event log: append-only generation/runtime telemetry, rewritten by every
# run. The distilled numbers live in reports/, which IS committed.
logs/
# Raw experiment output — deliberately contains fabricated clinical text.
# The readable write-up (reports/guard_experiment.md) is committed instead.
reports/guard_experiment_raw.json

# Phase 6 validation: remote-sliced sample VCFs and the PharmCAT jar are large
# and fully re-derivable from test-data/reference/manifest.json (which IS
# committed, with checksums and verified source URLs).
test-data/reference/slices/
test-data/reference/tools/

# bcftools writes a local .tbi beside the CWD when slicing a REMOTE panel, so
# these appear at the repo root as a byproduct of scripts/fetch_reference_data.py.
# They are indexes for panels we never download; re-fetched on demand.
/1kGP_high_coverage_Illumina.*.vcf.gz.tbi

# Phase 6 scale validation: the 400-sample cohort slices, the multi-sample VCF and
# PharmCAT's per-sample reports are large and fully re-derivable from
# scripts/validate_integration.py (deterministic cohort, seeded). The measured
# numbers live in reports/*.json, which ARE committed.
test-data/reference/cohort/
test-data/reference/pharmcat_testvcfs/

# PharmCAT writes a dated log beside the working directory on every run.
pharmcat.*.log

# Signing material — never commit
*.p12
*.pfx
*.pem

# Expanded SAS cohort: 98 MB of sliced VCF and 601 PharmCAT report sets.
# Regenerate with `python scripts/expand_sas_cohort.py` (41s slice + ~20 min).
# The analysis artifacts in reports/ ARE committed; the inputs are not.
test-data/reference/cohort/cohort_n601.vcf
test-data/reference/cohort/chr*_n601.vcf.gz*
test-data/reference/cohort/samples_n601.txt
test-data/reference/cohort/pharmcat_sas_n601/

# Local scratch copies of demo VCFs. The canonical files are in
# test-data/demo/ and app/assets/samples/; this directory is duplicates.
test-data/vcf/
