              '\n'
              '  PlatformFile? _file;\n'
              '  bool _loading = false;\n'
              '  String? _error;\n'
              '\n'
              '  /// Seconds since Analyze was pressed, and the ticker that advances it.\n'
              '  ///\n'
              '  /// Shown because an analysis takes about a minute on the free tier\n'
              '  /// (measured p50 51.3 s, p95 53.6 s) and a bare spinner for that long is\n'
              '  /// indistinguishable from a hang. A number that visibly moves is the\n'
              '  /// difference between "working" and "broken" when nothing else is on screen.\n'
              '  int _elapsed = 0;\n'
              '  Timer? _ticker;\n'
              '\n'
              '  /// What the backend says it is running, once asked. Null until then.\n'
              '  VersionSkew _skew = const VersionSkew(\n'
