              '  /// concurrent analyses measured 594 MB against a 512 MB limit). Rendering it\n'
              '  /// in the red error box would tell the user their file was rejected, and the\n'
              '  /// natural response to that is to go and re-export a VCF that was never wrong.\n'
              '  String? _busy;\n'
              '\n'
              '  /// What the chosen file can answer, fetched before the user commits to an\n'
              '  /// analysis. Null until a file is picked, or when the preview could not be\n'
              '  /// obtained — which is never fatal, because it is only a preview.\n'
              '  CoverageResponse? _readiness;\n'
              '  bool _checkingReadiness = false;\n'
              '\n'
              '  late final BackendStatusController _backend = BackendStatusController(\n'
              '    api: _api,\n'
              '  );\n'
              '\n'
              '  @override\n'
              '  void initState() {\n'
              '    super.initState();\n'
              '\n'
              '    // Fire and forget. A version check must never delay or block the UI: it is\n'
              '    // strictly extra information, and a slow or missing answer leaves the app\n'
              '    // exactly as usable as it was before the check existed.\n'
              '    _api.backendCommit().then((String? commit) {\n'
              '      if (!mounted || commit == null) return;\n'
              '      setState(\n'
              '        () =>\n'
              '            _skew = VersionSkew(expected: kExpectedBackendSha, actual: commit),\n'
              '      );\n'
              '    });\n'
              '    // Fire the wake-up ping immediately on load. On a free-tier backend that\n'
              '    // has scaled to zero this starts the cold start now, in parallel with the\n'
              '    // user picking a file, rather than at Analyze time.\n'
              '    _backend.addListener(_onBackendChanged);\n'
              '    _backend.wake();\n'
              '  }\n'
              '\n'
              '  void _onBackendChanged() {\n'
              '    if (mounted) setState(() {});\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  void dispose() {\n'
              '    // Stops the elapsed-time ticker firing setState on a dead widget.\n'
              '    _ticker?.cancel();\n'
              '    _backend.removeListener(_onBackendChanged);\n'
              '    _backend.dispose();\n'
              '    _drugsController.dispose();\n'
              '    super.dispose();\n'
              '  }\n'
              '\n'
              '  Future<void> _pickFile() async {\n'
              '    try {\n'
              '      // NB: `pickFiles` is static in file_picker 11+ (it was\n'
              '      // `FilePicker.platform.pickFiles` in earlier versions).\n'
              '      final FilePickerResult? picked = await FilePicker.pickFiles(\n'
              '        // Any file is accepted in Phase 1 — parsing is stubbed, and restricting\n'
              '        // to .vcf here would make the "any file works" behaviour untestable.\n'
              '        type: FileType.any,\n'
              '        // Required on mobile/desktop; web always returns bytes anyway. Using\n'
              '        // bytes uniformly means one upload path across all platforms.\n'
              '        withData: true,\n'
              '      );\n'
              '      if (picked == null || picked.files.isEmpty) return; // user cancelled\n'
              '      if (!mounted) return;\n'
              '      setState(() {\n'
              '        _file = picked.files.first;\n'
              '        _error = null;\n'
              '        _readiness = null;\n'
              '      });\n'
              '      await _checkReadiness();\n'
              '    } catch (e) {\n'
              '      if (!mounted) return;\n'
              '      setState(() => _error = \'Could not open the file chooser: $e\');\n'
              '    }\n'
              '  }\n'
              '\n'
              '  /// Ask the backend what this file can answer. Cheap — it does not run\n'
              '  /// PharmCAT — so it costs the user nothing to know in advance.\n'
              '  ///\n'
              '  /// Failures are swallowed on purpose. This is advisory: a user whose preview\n'
              '  /// did not load must still be able to run the analysis, and an error box for\n'
              '  /// a feature they did not ask for would read as though their file were bad.\n'
              '  /// Load a bundled sample as though the user had picked it.\n'
              '  ///\n'
              '  /// Goes through the SAME `PlatformFile` the file picker produces, so the\n'
              '  /// sample takes the identical path: readiness check, then /analyze. A\n'
              '  /// shortcut that bypassed either would demo a code path nobody else runs.\n'
              '  Future<void> _useSample(SampleFile sample) async {\n'
              '    try {\n'
              '      final String contents = await sample.load();\n'
              '      final Uint8List bytes = Uint8List.fromList(utf8.encode(contents));\n'
              '      if (!mounted) return;\n'
              '      setState(() {\n'
              '        _file = PlatformFile(\n'
              '          name: sample.fileName,\n'
              '          size: bytes.length,\n'
              '          bytes: bytes,\n'
              '        );\n'
              '        _readiness = null;\n'
              '        _error = null;\n'
              '        _busy = null;\n'
              '      });\n'
              '      await _checkReadiness();\n'
              '      if (!mounted) return;\n'
              '      await _analyze();\n'
              '    } catch (e) {\n'
              '      if (!mounted) return;\n'
              '      setState(() => _error = \'Could not load the sample file: $e\');\n'
              '    }\n'
              '  }\n'
              '\n'
              '  /// Hand the sample over as a real file the visitor can re-upload.\n'
              '  Future<void> _downloadSample(SampleFile sample) async {\n'
              '    try {\n'
              '      final String contents = await sample.load();\n'
              '      final String message = await exportText(sample.fileName, contents);\n'
              '      if (!mounted) return;\n'
              '      ScaffoldMessenger.of(\n'
              '        context,\n'
              '      ).showSnackBar(SnackBar(content: Text(message)));\n'
              '    } catch (e) {\n'
              '      if (!mounted) return;\n'
              '      ScaffoldMessenger.of(\n'
              '        context,\n'
              '      ).showSnackBar(SnackBar(content: Text(\'Could not save the sample: $e\')));\n'
              '    }\n'
              '  }\n'
              '\n'
              '  Future<void> _checkReadiness() async {\n'
              '    final PlatformFile? file = _file;\n'
              '    if (file?.bytes == null) return;\n'
              '\n'
              '    setState(() => _checkingReadiness = true);\n'
              '    try {\n'
              '      final CoverageResponse? readiness = await _api.coverage(\n'
              '        fileBytes: file!.bytes!,\n'
              '        fileName: file.name,\n'
              '      );\n'
              '      if (!mounted) return;\n'
              '      setState(() {\n'
              '        _readiness = readiness;\n'
              '        _checkingReadiness = false;\n'
              '      });\n'
              '    } on ApiException catch (e) {\n'
              '      if (!mounted) return;\n'
              '      setState(() {\n'
              '        _checkingReadiness = false;\n'
              '        // One exception to swallowing: a file the preview rejects is a file\n'
              '        // /analyze would reject too, so showing it here saves a wasted run.\n'
              '        if (e.statusCode == 400 || e.statusCode == 413) _error = e.message;\n'
              '      });\n'
              '    } catch (_) {\n'
              '      if (!mounted) return;\n'
              '      setState(() => _checkingReadiness = false);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  Future<void> _analyze() async {\n'
              '    final PlatformFile? file = _file;\n'
              '    if (file == null) {\n'
              '      setState(() => _error = \'Choose a VCF file first.\');\n'
              '      return;\n'
              '    }\n'
              '    if (file.bytes == null) {\n'
              '      setState(\n'
              '        () => _error =\n'
              '            \'Could not read the contents of "${file.name}". Try another file.\',\n'
              '      );\n'
              '      return;\n'
              '    }\n'
              '    if (_drugsController.text.trim().isEmpty) {\n'
              '      setState(() => _error = \'Enter at least one drug name.\');\n'
              '      return;\n'
              '    }\n'
              '\n'
              '    setState(() {\n'
              '      _loading = true;\n'
              '      _error = null;\n'
              '      _busy = null;\n'
              '      _elapsed = 0;\n'
              '    });\n'
              '    _ticker?.cancel();\n'
              '    _ticker = Timer.periodic(const Duration(seconds: 1), (Timer _) {\n'
              '      if (mounted) setState(() => _elapsed += 1);\n'
              '    });\n'
              '\n'
              '    try {\n'
              '      final AnalyzeResponse response = await _api.analyze(\n'
              '        fileBytes: file.bytes!,\n'
              '        fileName: file.name,\n'
              '        drugs: _drugsController.text.trim(),\n'
              '      );\n'
              '      if (!mounted) return;\n'
              '      _ticker?.cancel();\n'
              '      setState(() => _loading = false);\n'
              '      await Navigator.of(context).push(\n'
              '        MaterialPageRoute<void>(\n'
              '          builder: (_) => ResultsScreen(response: response),\n'
              '        ),\n'
              '      );\n'
              '    } on ApiException catch (e) {\n'
              '      if (!mounted) return;\n'
              '      _ticker?.cancel();\n'
              '      setState(() {\n'
              '        _loading = false;\n'
              '        if (e.isBusy) {\n'
              '          _busy = e.message;\n'
              '        } else {\n'
              '          _error = e.message;\n'
              '        }\n'
              '      });\n'
              '      // A failed call is the most likely moment for the backend to have gone\n'
              '      // away; reflect that in the banner without starting a fresh ping storm.\n'
              '      //\n'
              '      // Rejected input, busy, and rate-limited responses also prove the server\n'
              '      // is up. Only a transport failure or unavailable engine changes status.\n'
              '      if (e.shouldMarkBackendUnreachable) _backend.markUnreachable(e.message);\n'
              '    } catch (e) {\n'
              '      if (!mounted) return;\n'
              '      _ticker?.cancel();\n'
              '      setState(() {\n'
              '        _loading = false;\n'
              '        _error = \'Unexpected error: $e\';\n'
              '      });\n'
              '    }\n'
              '  }\n'
              '\n'
              '  /// Run every drug this build covers, in one action.\n'
              '  ///\n'
              '  /// THE DISCOVERY PATH. Naming a drug requires already suspecting it, and the\n'
              '  /// person best served by this system is precisely the one who does not know\n'
              '  /// which of their medicines is affected. This asks the question for them.\n'
              '  Future<void> _checkEverything() async {\n'
              '    _drugsController.text = kDemoDrugs.join(\',\');\n'
              '    await _analyze();\n'
              '  }\n'
              '\n'
              '  /// Append a demo drug to the field if it is not already listed.\n'
              '  void _addDrug(String drug) {\n'
              '    final List<String> current = _drugsController.text\n'
              '        .split(\',\')\n'
              '        .map((String s) => s.trim())\n'
              '        .where((String s) => s.isNotEmpty)\n'
              '        .toList();\n'
              '    if (current.any((String d) => d.toLowerCase() == drug)) return;\n'
              '    current.add(drug);\n'
              '    _drugsController.text = current.join(\',\');\n'
              '  }\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '\n'
              '    // One scope per screen: first use is per screen, not per app.\n'
              '    return GlossaryScope(\n'
              '      child: BannerScaffold(\n'
              '        appBar: AppBar(\n'
              '          title: const Text(\'PharmaGuard\'),\n'
              '          actions: <Widget>[\n'
              '            IconButton(\n'
              '              icon: const Icon(Icons.info_outline),\n'
              '              tooltip: \'About PharmaGuard\',\n'
              '              onPressed: () => Navigator.of(context).push(\n'
              '                MaterialPageRoute<void>(builder: (_) => const AboutScreen()),\n'
              '              ),\n'
              '            ),\n'
              '            IconButton(\n'
              '              tooltip: \'Re-check backend connection\',\n'
              '              onPressed: _backend.wake,\n'
              '              icon: const Icon(Icons.refresh),\n'
              '            ),\n'
              '          ],\n'
              '        ),\n'
              '        body: Center(\n'
              '          child: ConstrainedBox(\n'
              '            // Keeps the form readable on a wide desktop browser window.\n'
              '            constraints: const BoxConstraints(maxWidth: 720),\n'
              '            child: ListView(\n'
              '              padding: const EdgeInsets.all(20),\n'
              '              children: <Widget>[\n'
              '                Text(\n'
              '                  \'Pharmacogenomic risk prediction\',\n'
              '                  style: theme.textTheme.headlineSmall?.copyWith(\n'
              '                    fontWeight: FontWeight.w700,\n'
              '                  ),\n'
              '                ),\n'
              '                const SizedBox(height: 6),\n'
              '                Text(\n'
              '                  // The old copy called the explanations "placeholders". They are\n'
              '                  // pre-generated, guard-checked and provenance-verified — the line\n'
              '                  // undersold the work and contradicted the README.\n'
              '                  \'Upload a GRCh38 VCF and list the drugs to check. Genotypes are \'\n'
              '                  \'called by PharmCAT, dosing guidance is quoted from CPIC, and the \'\n'
              '                  \'explanations are pre-generated and checked against their source.\',\n'
              '                  style: theme.textTheme.bodyMedium?.copyWith(\n'
              '                    color: theme.colorScheme.onSurfaceVariant,\n'
              '                  ),\n'
              '                ),\n'
              '                const SizedBox(height: 16),\n'
              '                BackendStatusBanner(\n'
              '                  status: _backend.status,\n'
              '                  onRetry: _backend.wake,\n'
              '                ),\n'
              '                const SizedBox(height: 20),\n'
              '\n'
              '                // --- Step 1: file ------------------------------------------\n'
              '                _StepHeader(number: 1, title: \'Choose a VCF file\'),\n'
              '                const SizedBox(height: 8),\n'
              '                _FileDropCard(file: _file, onPick: _loading ? null : _pickFile),\n'
              '                const SizedBox(height: 12),\n'
              '                SampleFilesCard(\n'
              '                  onTry: _useSample,\n'
              '                  onDownload: _downloadSample,\n'
              '                  busy: _loading,\n'
              '                ),\n'
              '                if (_checkingReadiness) ...<Widget>[\n'
              '                  const SizedBox(height: 10),\n'
              '                  const _ReadinessPending(),\n'
              '                ] else if (_readiness != null) ...<Widget>[\n'
              '                  const SizedBox(height: 12),\n'
              '                  FileReadinessPanel(\n'
              '                    readiness: _readiness!,\n'
              '                    onShowRequirements: () => Navigator.of(context).push(\n'
              '                      MaterialPageRoute<void>(\n'
              '                        builder: (_) => const AboutScreen(),\n'
              '                      ),\n'
              '                    ),\n'
              '                  ),\n'
              '                ],\n'
              '                const SizedBox(height: 24),\n'
              '\n'
              '                // --- Step 2: drugs -----------------------------------------\n'
              '                _StepHeader(number: 2, title: \'List the drugs\'),\n'
              '                const SizedBox(height: 8),\n'
              '                TextField(\n'
              '                  controller: _drugsController,\n'
              '                  enabled: !_loading,\n'
              '                  textInputAction: TextInputAction.done,\n'
              '                  onSubmitted: (_) => _loading ? null : _analyze(),\n'
              '                  decoration: const InputDecoration(\n'
              '                    labelText: \'Drugs (comma-separated)\',\n'
              '                    hintText: \'codeine,warfarin,clopidogrel\',\n'
              '                    prefixIcon: Icon(Icons.medication_outlined),\n'
              '                    border: OutlineInputBorder(),\n'
              '                  ),\n'
              '                ),\n'
              '                const SizedBox(height: 10),\n'
              '                Text(\n'
              '                  \'Drugs with CPIC guidance in this build — anything else returns \'\n'
              '                  \'"Unknown":\',\n'
              '                  style: theme.textTheme.labelSmall?.copyWith(\n'
              '                    color: theme.colorScheme.onSurfaceVariant,\n'
              '                  ),\n'
              '                ),\n'
              '                const SizedBox(height: 6),\n'
              '                Wrap(\n'
              '                  spacing: 6,\n'
              '                  runSpacing: 6,\n'
              '                  children: <Widget>[\n'
              '                    for (final String drug in kDemoDrugs)\n'
              '                      ActionChip(\n'
              '                        visualDensity: VisualDensity.compact,\n'
              '                        label: Text(drug),\n'
              '                        onPressed: _loading ? null : () => _addDrug(drug),\n'
              '                      ),\n'
              '                  ],\n'
              '                ),\n'
              '                const SizedBox(height: 24),\n'
              '\n'
              '                // --- Step 3: go --------------------------------------------\n'
              '                FilledButton.icon(\n'
              '                  onPressed: _loading ? null : _analyze,\n'
              '                  icon: _loading\n'
              '                      ? const SizedBox(\n'
              '                          width: 18,\n'
              '                          height: 18,\n'
              '                          child: CircularProgressIndicator(strokeWidth: 2.4),\n'
              '                        )\n'
              '                      : const Icon(Icons.analytics_outlined),\n'
              '                  label: Text(_loading ? \'Analyzing…\' : \'Analyze\'),\n'
              '                  style: FilledButton.styleFrom(\n'
              '                    padding: const EdgeInsets.symmetric(vertical: 16),\n'
              '                    textStyle: const TextStyle(\n'
              '                      fontSize: 16,\n'
              '                      fontWeight: FontWeight.w600,\n'
              '                    ),\n'
              '                  ),\n'
              '                ),\n'
              '\n'
              '                const SizedBox(height: 10),\n'
              '                OutlinedButton.icon(\n'
              '                  onPressed: _loading ? null : _checkEverything,\n'
              '                  icon: const Icon(Icons.checklist_outlined, size: 19),\n'
              '                  label: Text(\n'
              '                    \'Check all ${kDemoDrugs.length} medicines\',\n'
              '                    style: Tokens.uiMd.copyWith(fontWeight: FontWeight.w600),\n'
              '                  ),\n'
              '                  style: OutlinedButton.styleFrom(\n'
              '                    padding: const EdgeInsets.symmetric(vertical: 14),\n'
              '                    side: const BorderSide(\n'
              '                      color: Tokens.rule2,\n'
              '                      width: Tokens.hairline,\n'
              '                    ),\n'
              '                  ),\n'
              '                ),\n'
              '                const SizedBox(height: 6),\n'
              '                Text(\n'
              '                  \'Results are ordered by consequence, not alphabetically — the \'\n'
              '                  \'row that changes something comes first.\',\n'
              '                  style: Tokens.uiSm,\n'
              '                ),\n'
              '\n'
              '                if (_skew.isMismatch) ...<Widget>[\n'
              '                  const SizedBox(height: 12),\n'
              '                  VersionNotice(skew: _skew),\n'
              '                ],\n'
              '                if (_loading) ...<Widget>[\n'
              '                  const SizedBox(height: 14),\n'
              '                  _AnalysisProgress(elapsed: _elapsed),\n'
              '                ],\n'
              '                if (_busy != null) ...<Widget>[\n'
              '                  const SizedBox(height: 14),\n'
              '                  _BusyBox(\n'
              '                    message: _busy!,\n'
              '                    onRetry: _loading ? null : _analyze,\n'
              '                  ),\n'
              '                ],\n'
              '                if (_error != null) ...<Widget>[\n'
              '                  const SizedBox(height: 16),\n'
              '                  _ErrorBox(message: _error!),\n'
              '                ],\n'
              '              ],\n'
              '            ),\n'
              '          ),\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              '// --------------------------------------------------------------------------- //\n'
              '\n'
              'class _StepHeader extends StatelessWidget {\n'
              '  const _StepHeader({required this.number, required this.title});\n'
              '\n'
              '  final int number;\n'
              '  final String title;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    return Row(\n'
              '      children: <Widget>[\n'
              '        CircleAvatar(\n'
              '          radius: 11,\n'
              '          backgroundColor: theme.colorScheme.primary,\n'
              '          child: Text(\n'
              '            \'$number\',\n'
              '            style: theme.textTheme.labelSmall?.copyWith(\n'
              '              color: theme.colorScheme.onPrimary,\n'
              '              fontWeight: FontWeight.w800,\n'
              '            ),\n'
              '          ),\n'
              '        ),\n'
              '        const SizedBox(width: 8),\n'
              '        Text(\n'
              '          title,\n'
              '          style: theme.textTheme.titleSmall?.copyWith(\n'
              '            fontWeight: FontWeight.w700,\n'
              '          ),\n'
              '        ),\n'
              '      ],\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              '/// The gap between choosing a file and knowing what it can answer. Measured at\n'
              '/// a couple of milliseconds locally, so this is rarely seen — but a silent gap\n'
              '/// would look like nothing happened.\n'
              'class _ReadinessPending extends StatelessWidget {\n'
              '  const _ReadinessPending();\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) => Row(\n'
              '    children: <Widget>[\n'
              '      const SizedBox(\n'
              '        width: 13,\n'
              '        height: 13,\n'
              '        child: CircularProgressIndicator(strokeWidth: 2),\n'
              '      ),\n'
              '      const SizedBox(width: 9),\n'
              '      Text(\n'
              '        \'Checking what this file can answer…\',\n'
              '        style: Theme.of(context).textTheme.bodySmall,\n'
              '      ),\n'
              '    ],\n'
              '  );\n'
              '}\n'
              '\n'
              'class _FileDropCard extends StatelessWidget {\n'
              '  const _FileDropCard({required this.file, required this.onPick});\n'
              '\n'
              '  final PlatformFile? file;\n'
              '  final VoidCallback? onPick;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    final PlatformFile? f = file;\n'
              '\n'
              '    return InkWell(\n'
              '      onTap: onPick,\n'
              '      borderRadius: BorderRadius.circular(12),\n'
              '      child: Container(\n'
              '        width: double.infinity,\n'
              '        padding: const EdgeInsets.all(16),\n'
              '        decoration: BoxDecoration(\n'
              '          borderRadius: BorderRadius.circular(12),\n'
              '          border: Border.all(\n'
              '            color: f == null\n'
              '                ? theme.colorScheme.outlineVariant\n'
              '                : theme.colorScheme.primary,\n'
              '          ),\n'
              '          color: f == null\n'
              '              ? null\n'
              '              : theme.colorScheme.primaryContainer.withValues(alpha: 0.35),\n'
              '        ),\n'
              '        child: Row(\n'
              '          children: <Widget>[\n'
              '            Icon(\n'
              '              f == null\n'
              '                  ? Icons.upload_file_outlined\n'
              '                  : Icons.description_outlined,\n'
              '              size: 30,\n'
              '              color: f == null\n'
              '                  ? theme.colorScheme.onSurfaceVariant\n'
              '                  : theme.colorScheme.primary,\n'
              '            ),\n'
              '            const SizedBox(width: 14),\n'
              '            Expanded(\n'
              '              child: Column(\n'
              '                crossAxisAlignment: CrossAxisAlignment.start,\n'
              '                children: <Widget>[\n'
              '                  Text(\n'
              '                    f?.name ?? \'No file selected\',\n'
              '                    style: theme.textTheme.bodyLarge?.copyWith(\n'
              '                      fontWeight: FontWeight.w600,\n'
              '                    ),\n'
              '                    overflow: TextOverflow.ellipsis,\n'
              '                  ),\n'
              '                  const SizedBox(height: 2),\n'
              '                  Text(\n'
              '                    f == null\n'
              '                        ? \'Tap to browse — or use a sample below\'\n'
              '                        : \'${_humanSize(f.size)} · tap to change\',\n'
              '                    style: theme.textTheme.bodySmall?.copyWith(\n'
              '                      color: theme.colorScheme.onSurfaceVariant,\n'
              '                    ),\n'
              '                  ),\n'
              '                ],\n'
              '              ),\n'
              '            ),\n'
              '          ],\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  static String _humanSize(int bytes) {\n'
              '    if (bytes < 1024) return \'$bytes B\';\n'
              '    if (bytes < 1024 * 1024) return \'${(bytes / 1024).toStringAsFixed(1)} KB\';\n'
              '    return \'${(bytes / (1024 * 1024)).toStringAsFixed(1)} MB\';\n'
              '  }\n'
              '}\n'
              '\n'
              '/// What the user sees for the ~1 minute an analysis takes.\n'
              '///\n'
              '/// THE COST IS STATED, NOT HIDDEN. On the free hosting tier an analysis\n'
              '/// measures p50 51.3 s / p95 53.6 s, against ~2.6 s on a developer laptop —\n'
              '/// the difference is a shared CPU running a JVM, not the pipeline. A spinner\n'
              '/// alone for that long reads as a hang, and a user who thinks it has hung\n'
              '/// reloads, which costs them the whole minute again.\n'
              '///\n'
              '/// So this says roughly how long it will take, shows a number that visibly\n'
              '/// moves, and says why. Naming the reason matters: "about a minute" with no\n'
              '/// explanation sounds like slow software, where "shared free CPU, and the\n'
              '/// genotype caller is a Java process" is a fact about the hosting.\n'
              'class _AnalysisProgress extends StatelessWidget {\n'
              '  const _AnalysisProgress({required this.elapsed});\n'
              '\n'
              '  final int elapsed;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    // Cap the bar just short of full: reaching 100% while still waiting is\n'
              '    // worse than no bar at all, and the real distribution has a tail.\n'
              '    final double progress = (elapsed / 60).clamp(0.0, 0.95);\n'
              '    return Container(\n'
              '      width: double.infinity,\n'
              '      padding: const EdgeInsets.all(14),\n'
              '      decoration: BoxDecoration(\n'
              '        color: theme.colorScheme.surfaceContainerHighest,\n'
              '        borderRadius: BorderRadius.circular(12),\n'
              '        border: Border.all(color: theme.colorScheme.outlineVariant),\n'
              '      ),\n'
              '      child: Column(\n'
              '        crossAxisAlignment: CrossAxisAlignment.start,\n'
              '        children: <Widget>[\n'
              '          Row(\n'
              '            children: <Widget>[\n'
              '              Icon(\n'
              '                Icons.biotech_outlined,\n'
              '                size: 20,\n'
              '                color: theme.colorScheme.onSurfaceVariant,\n'
              '              ),\n'
              '              const SizedBox(width: 10),\n'
              '              Expanded(\n'
              '                child: Text(\n'
              '                  \'Analysing your file — about a minute\',\n'
              '                  style: theme.textTheme.titleSmall?.copyWith(\n'
              '                    fontWeight: FontWeight.w600,\n'
              '                    color: theme.colorScheme.onSurfaceVariant,\n'
              '                  ),\n'
              '                ),\n'
              '              ),\n'
              '              Text(\n'
              '                \'${elapsed}s\',\n'
              '                style: theme.textTheme.titleSmall?.copyWith(\n'
              '                  fontFeatures: const <FontFeature>[\n'
              '                    FontFeature.tabularFigures(),\n'
              '                  ],\n'
              '                  color: theme.colorScheme.onSurfaceVariant,\n'
              '                ),\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '          const SizedBox(height: 10),\n'
              '          ClipRRect(\n'
              '            borderRadius: BorderRadius.circular(4),\n'
              '            child: LinearProgressIndicator(\n'
              '              value: progress == 0 ? null : progress,\n'
              '              minHeight: 6,\n'
              '            ),\n'
              '          ),\n'
              '          const SizedBox(height: 10),\n'
              '          Text(\n'
              '            \'The genotype caller is a Java program running on a free shared \'\n'
              '            \'CPU, so this takes roughly 50–60 seconds. Nothing is stuck. \'\n'
              '            \'Please do not reload — that starts the wait again.\',\n'
              '            style: theme.textTheme.bodySmall?.copyWith(\n'
              '              color: theme.colorScheme.onSurfaceVariant,\n'
              '              height: 1.45,\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              '/// The 503 SERVER_BUSY panel.\n'
              '///\n'
              '/// Deliberately NOT the error colour. Three different waits reach this screen\n'
              '/// and each needs its own reading:\n'
              '///\n'
              '///   cold start   the container is booting        — wait, nothing to do\n'
              '///   429          you asked too many times        — wait, and it is your doing\n'
              '///   SERVER_BUSY  someone else is analysing now   — wait, and it is nobody\'s\n'
              '///\n'
              '/// Given the same red box, a user cannot tell which they are in, and the\n'
              '/// reasonable guess after clicking Analyze is always "my file is bad".\n'
              'class _BusyBox extends StatelessWidget {\n'
              '  const _BusyBox({required this.message, this.onRetry});\n'
              '\n'
              '  final String message;\n'
              '  final VoidCallback? onRetry;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    return Container(\n'
              '      width: double.infinity,\n'
              '      padding: const EdgeInsets.all(14),\n'
              '      decoration: BoxDecoration(\n'
              '        color: theme.colorScheme.secondaryContainer,\n'
              '        borderRadius: BorderRadius.circular(12),\n'
              '        border: Border.all(\n'
              '          color: theme.colorScheme.secondary.withValues(alpha: 0.5),\n'
              '        ),\n'
              '      ),\n'
              '      child: Row(\n'
              '        crossAxisAlignment: CrossAxisAlignment.start,\n'
              '        children: <Widget>[\n'
              '          Icon(\n'
              '            Icons.hourglass_top,\n'
              '            color: theme.colorScheme.onSecondaryContainer,\n'
              '          ),\n'
              '          const SizedBox(width: 10),\n'
              '          Expanded(\n'
              '            child: Column(\n'
              '              crossAxisAlignment: CrossAxisAlignment.start,\n'
              '              children: <Widget>[\n'
              '                SelectableText(\n'
              '                  message,\n'
              '                  style: theme.textTheme.bodySmall?.copyWith(\n'
              '                    color: theme.colorScheme.onSecondaryContainer,\n'
              '                    height: 1.45,\n'
              '                  ),\n'
              '                ),\n'
              '                if (onRetry != null) ...<Widget>[\n'
              '                  const SizedBox(height: 8),\n'
              '                  FilledButton.tonalIcon(\n'
              '                    onPressed: onRetry,\n'
              '                    icon: const Icon(Icons.refresh, size: 18),\n'
              '                    label: const Text(\'Try again\'),\n'
              '                  ),\n'
              '                ],\n'
              '              ],\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _ErrorBox extends StatelessWidget {\n'
              '  const _ErrorBox({required this.message});\n'
              '\n'
              '  final String message;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    return Container(\n'
              '      width: double.infinity,\n'
              '      padding: const EdgeInsets.all(14),\n'
              '      decoration: BoxDecoration(\n'
              '        color: theme.colorScheme.errorContainer,\n'
              '        borderRadius: BorderRadius.circular(12),\n'
              '        border: Border.all(\n'
              '          color: theme.colorScheme.error.withValues(alpha: 0.5),\n'
              '        ),\n'
              '      ),\n'
              '      child: Row(\n'
              '        crossAxisAlignment: CrossAxisAlignment.start,\n'
              '        children: <Widget>[\n'
              '          Icon(Icons.error_outline, color: theme.colorScheme.onErrorContainer),\n'
              '          const SizedBox(width: 10),\n'
              '          Expanded(\n'
              '            child: SelectableText(\n'
              '              message,\n'
              '              style: theme.textTheme.bodySmall?.copyWith(\n'
              '                color: theme.colorScheme.onErrorContainer,\n'
              '                height: 1.45,\n'
              '              ),\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              ''
  
