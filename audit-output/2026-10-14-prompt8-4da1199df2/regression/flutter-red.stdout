              '                ],\n'
              '                if (_busy != null) ...<Widget>[\n'
              '                  const SizedBox(height: 14),\n'
              '                  _BusyBox(\n'
              '                    message: _busy!,\n'
              '                    onRetry: _loading ? null : _analyze,\n'
              '                  ),\n'
              '                ],\n'
              '                if (_error != null) ...<Widget>[\n'
              '                  const SizedBox(height: 16),\n'
              '                  _ErrorBox(message: _error!),\n'
              '                ],\n'
              '              ],\n'
              '            ),\n'
              '          ),\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              '// --------------------------------------------------------------------------- //\n'
              '\n'
              'class _StepHeader extends StatelessWidget {\n'
              '  const _StepHeader({required this.number, required this.title});\n'
              '\n'
              '  final int number;\n'
              '  final String title;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    return Row(\n'
              '      children: <Widget>[\n'
              '        CircleAvatar(\n'
              '          radius: 11,\n'
              '          backgroundColor: theme.colorScheme.primary,\n'
              '          child: Text(\n'
              '            \'$number\',\n'
              '            style: theme.textTheme.labelSmall?.copyWith(\n'
              '              color: theme.colorScheme.onPrimary,\n'
              '              fontWeight: FontWeight.w800,\n'
              '            ),\n'
              '          ),\n'
              '        ),\n'
              '        const SizedBox(width: 8),\n'
              '        Text(\n'
              '          title,\n'
              '          style: theme.textTheme.titleSmall?.copyWith(\n'
              '            fontWeight: FontWeight.w700,\n'
              '          ),\n'
              '        ),\n'
              '      ],\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              '/// The gap between choosing a file and knowing what it can answer. Measured at\n'
              '/// a couple of milliseconds locally, so this is rarely seen — but a silent gap\n'
              '/// would look like nothing happened.\n'
              'class _ReadinessPending extends StatelessWidget {\n'
              '  const _ReadinessPending();\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) => Row(\n'
              '    children: <Widget>[\n'
              '      const SizedBox(\n'
              '        width: 13,\n'
              '        height: 13,\n'
              '        child: CircularProgressIndicator(strokeWidth: 2),\n'
              '      ),\n'
              '      const SizedBox(width: 9),\n'
              '      Text(\n'
              '        \'Checking what this file can answer…\',\n'
              '        style: Theme.of(context).textTheme.bodySmall,\n'
              '      ),\n'
              '    ],\n'
              '  );\n'
              '}\n'
              '\n'
              'class _FileDropCard extends StatelessWidget {\n'
              '  const _FileDropCard({required this.file, required this.onPick});\n'
              '\n'
              '  final PlatformFile? file;\n'
              '  final VoidCallback? onPick;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    final PlatformFile? f = file;\n'
              '\n'
              '    return InkWell(\n'
              '      onTap: onPick,\n'
              '      borderRadius: BorderRadius.circular(12),\n'
              '      child: Container(\n'
              '        width: double.infinity,\n'
              '        padding: const EdgeInsets.all(16),\n'
              '        decoration: BoxDecoration(\n'
              '          borderRadius: BorderRadius.circular(12),\n'
              '          border: Border.all(\n'
              '            color: f == null\n'
              '                ? theme.colorScheme.outlineVariant\n'
              '                : theme.colorScheme.primary,\n'
              '          ),\n'
              '          color: f == null\n'
              '              ? null\n'
              '              : theme.colorScheme.primaryContainer.withValues(alpha: 0.35),\n'
              '        ),\n'
              '        child: Row(\n'
              '          children: <Widget>[\n'
              '            Icon(\n'
              '              f == null\n'
              '                  ? Icons.upload_file_outlined\n'
              '                  : Icons.description_outlined,\n'
              '              size: 30,\n'
              '              color: f == null\n'
              '                  ? theme.colorScheme.onSurfaceVariant\n'
              '                  : theme.colorScheme.primary,\n'
              '            ),\n'
              '            const SizedBox(width: 14),\n'
              '            Expanded(\n'
              '              child: Column(\n'
              '                crossAxisAlignment: CrossAxisAlignment.start,\n'
              '                children: <Widget>[\n'
              '                  Text(\n'
              '                    f?.name ?? \'No file selected\',\n'
              '                    style: theme.textTheme.bodyLarge?.copyWith(\n'
              '                      fontWeight: FontWeight.w600,\n'
              '                    ),\n'
              '                    overflow: TextOverflow.ellipsis,\n'
              '                  ),\n'
              '                  const SizedBox(height: 2),\n'
              '                  Text(\n'
              '                    f == null\n'
              '                        ? \'Tap to browse — or use a sample below\'\n'
              '                        : \'${_humanSize(f.size)} · tap to change\',\n'
              '                    style: theme.textTheme.bodySmall?.copyWith(\n'
              '                      color: theme.colorScheme.onSurfaceVariant,\n'
              '                    ),\n'
              '                  ),\n'
              '                ],\n'
              '              ),\n'
              '            ),\n'
              '          ],\n'
              '        ),\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  static String _humanSize(int bytes) {\n'
              '    if (bytes < 1024) return \'$bytes B\';\n'
              '    if (bytes < 1024 * 1024) return \'${(bytes / 1024).toStringAsFixed(1)} KB\';\n'
              '    return \'${(bytes / (1024 * 1024)).toStringAsFixed(1)} MB\';\n'
              '  }\n'
              '}\n'
              '\n'
              '/// What the user sees for the ~1 minute an analysis takes.\n'
              '///\n'
              '/// THE COST IS STATED, NOT HIDDEN. On the free hosting tier an analysis\n'
              '/// measures p50 51.3 s / p95 53.6 s, against ~2.6 s on a developer laptop —\n'
              '/// the difference is a shared CPU running a JVM, not the pipeline. A spinner\n'
              '/// alone for that long reads as a hang, and a user who thinks it has hung\n'
              '/// reloads, which costs them the whole minute again.\n'
              '///\n'
              '/// So this says roughly how long it will take, shows a number that visibly\n'
              '/// moves, and says why. Naming the reason matters: "about a minute" with no\n'
              '/// explanation sounds like slow software, where "shared free CPU, and the\n'
              '/// genotype caller is a Java process" is a fact about the hosting.\n'
              'class _AnalysisProgress extends StatelessWidget {\n'
              '  const _AnalysisProgress({required this.elapsed});\n'
              '\n'
              '  final int elapsed;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    // Cap the bar just short of full: reaching 100% while still waiting is\n'
              '    // worse than no bar at all, and the real distribution has a tail.\n'
              '    final double progress = (elapsed / 60).clamp(0.0, 0.95);\n'
              '    return Container(\n'
              '      width: double.infinity,\n'
              '      padding: const EdgeInsets.all(14),\n'
              '      decoration: BoxDecoration(\n'
              '        color: theme.colorScheme.surfaceContainerHighest,\n'
              '        borderRadius: BorderRadius.circular(12),\n'
              '        border: Border.all(color: theme.colorScheme.outlineVariant),\n'
              '      ),\n'
              '      child: Column(\n'
              '        crossAxisAlignment: CrossAxisAlignment.start,\n'
              '        children: <Widget>[\n'
              '          Row(\n'
              '            children: <Widget>[\n'
              '              Icon(\n'
              '                Icons.biotech_outlined,\n'
              '                size: 20,\n'
              '                color: theme.colorScheme.onSurfaceVariant,\n'
              '              ),\n'
              '              const SizedBox(width: 10),\n'
              '              Expanded(\n'
              '                child: Text(\n'
              '                  \'Analysing your file — about a minute\',\n'
              '                  style: theme.textTheme.titleSmall?.copyWith(\n'
              '                    fontWeight: FontWeight.w600,\n'
              '                    color: theme.colorScheme.onSurfaceVariant,\n'
              '                  ),\n'
              '                ),\n'
              '              ),\n'
              '              Text(\n'
              '                \'${elapsed}s\',\n'
              '                style: theme.textTheme.titleSmall?.copyWith(\n'
              '                  fontFeatures: const <FontFeature>[\n'
              '                    FontFeature.tabularFigures(),\n'
              '                  ],\n'
              '                  color: theme.colorScheme.onSurfaceVariant,\n'
              '                ),\n'
              '              ),\n'
              '            ],\n'
              '          ),\n'
              '          const SizedBox(height: 10),\n'
              '          ClipRRect(\n'
              '            borderRadius: BorderRadius.circular(4),\n'
              '            child: LinearProgressIndicator(\n'
              '              value: progress == 0 ? null : progress,\n'
              '              minHeight: 6,\n'
              '            ),\n'
              '          ),\n'
              '          const SizedBox(height: 10),\n'
              '          Text(\n'
              '            \'The genotype caller is a Java program running on a free shared \'\n'
              '            \'CPU, so this takes roughly 50–60 seconds. Nothing is stuck. \'\n'
              '            \'Please do not reload — that starts the wait again.\',\n'
              '            style: theme.textTheme.bodySmall?.copyWith(\n'
              '              color: theme.colorScheme.onSurfaceVariant,\n'
              '              height: 1.45,\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              '/// The 503 SERVER_BUSY panel.\n'
              '///\n'
              '/// Deliberately NOT the error colour. Three different waits reach this screen\n'
              '/// and each needs its own reading:\n'
              '///\n'
              '///   cold start   the container is booting        — wait, nothing to do\n'
              '///   429          you asked too many times        — wait, and it is your doing\n'
              '///   SERVER_BUSY  someone else is analysing now   — wait, and it is nobody\'s\n'
              '///\n'
              '/// Given the same red box, a user cannot tell which they are in, and the\n'
              '/// reasonable guess after clicking Analyze is always "my file is bad".\n'
              'class _BusyBox extends StatelessWidget {\n'
              '  const _BusyBox({required this.message, this.onRetry});\n'
              '\n'
              '  final String message;\n'
              '  final VoidCallback? onRetry;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    return Container(\n'
              '      width: double.infinity,\n'
              '      padding: const EdgeInsets.all(14),\n'
              '      decoration: BoxDecoration(\n'
              '        color: theme.colorScheme.secondaryContainer,\n'
              '        borderRadius: BorderRadius.circular(12),\n'
              '        border: Border.all(\n'
              '          color: theme.colorScheme.secondary.withValues(alpha: 0.5),\n'
              '        ),\n'
              '      ),\n'
              '      child: Row(\n'
              '        crossAxisAlignment: CrossAxisAlignment.start,\n'
              '        children: <Widget>[\n'
              '          Icon(\n'
              '            Icons.hourglass_top,\n'
              '            color: theme.colorScheme.onSecondaryContainer,\n'
              '          ),\n'
              '          const SizedBox(width: 10),\n'
              '          Expanded(\n'
              '            child: Column(\n'
              '              crossAxisAlignment: CrossAxisAlignment.start,\n'
              '              children: <Widget>[\n'
              '                SelectableText(\n'
              '                  message,\n'
              '                  style: theme.textTheme.bodySmall?.copyWith(\n'
              '                    color: theme.colorScheme.onSecondaryContainer,\n'
              '                    height: 1.45,\n'
              '                  ),\n'
              '                ),\n'
              '                if (onRetry != null) ...<Widget>[\n'
              '                  const SizedBox(height: 8),\n'
              '                  FilledButton.tonalIcon(\n'
              '                    onPressed: onRetry,\n'
              '                    icon: const Icon(Icons.refresh, size: 18),\n'
              '                    label: const Text(\'Try again\'),\n'
              '                  ),\n'
              '                ],\n'
              '              ],\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'class _ErrorBox extends StatelessWidget {\n'
              '  const _ErrorBox({required this.message});\n'
              '\n'
              '  final String message;\n'
              '\n'
              '  @override\n'
              '  Widget build(BuildContext context) {\n'
              '    final ThemeData theme = Theme.of(context);\n'
              '    return Container(\n'
              '      width: double.infinity,\n'
              '      padding: const EdgeInsets.all(14),\n'
              '      decoration: BoxDecoration(\n'
              '        color: theme.colorScheme.errorContainer,\n'
              '        borderRadius: BorderRadius.circular(12),\n'
              '        border: Border.all(\n'
              '          color: theme.colorScheme.error.withValues(alpha: 0.5),\n'
              '        ),\n'
              '      ),\n'
              '      child: Row(\n'
              '        crossAxisAlignment: CrossAxisAlignment.start,\n'
              '        children: <Widget>[\n'
              '          Icon(Icons.error_outline, color: theme.colorScheme.onErrorContainer),\n'
              '          const SizedBox(width: 10),\n'
              '          Expanded(\n'
              '            child: SelectableText(\n'
              '              message,\n'
              '              style: theme.textTheme.bodySmall?.copyWith(\n'
              '                color: theme.colorScheme.onErrorContainer,\n'
              '                height: 1.45,\n'
              '              ),\n'
              '            ),\n'
              '          ),\n'
              '        ],\n'
              '      ),\n'
              '    );\n'
              '  }\n'
              '}\n'
              ''
  
