              '\n'
              'class HomeScreen extends StatefulWidget {\n'
              '  const HomeScreen({super.key});\n'
              '\n'
              '  @override\n'
              '  State<HomeScreen> createState() => _HomeScreenState();\n'
              '}\n'
              '\n'
              'class _HomeScreenState extends State<HomeScreen> {\n'
              '  final PharmaGuardApi _api = PharmaGuardApi();\n'
              '  final TextEditingController _drugsController = TextEditingController(\n'
