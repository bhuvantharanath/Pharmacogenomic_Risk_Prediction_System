              '  /// obtained — which is never fatal, because it is only a preview.\n'
              '  CoverageResponse? _readiness;\n'
              '  bool _checkingReadiness = false;\n'
              '\n'
              '  late final BackendStatusController _backend = BackendStatusController(\n'
              '    api: _api,\n'
              '  );\n'
              '\n'
              '  @override\n'
              '  void initState() {\n'
              '    super.initState();\n'
              '\n'
              '    // Fire and forget. A version check must never delay or block the UI: it is\n'
              '    // strictly extra information, and a slow or missing answer leaves the app\n'
              '    // exactly as usable as it was before the check existed.\n'
              '    _api.backendCommit().then((String? commit) {\n'
