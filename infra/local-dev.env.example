# Local development configuration — NON-SECRET values only.
#
# Deliberately NOT named `backend/.env`: `assert_no_baked_secrets` refuses to
# start when that file exists, because a .env inside a deployed image is a
# credential-leak risk. This file exists to converge local configuration with
# deployed configuration, and it must never gain a secret. Nothing here is one.
#
#   set -a && source infra/local-dev.env && set +a
#   cd backend && uvicorn app.main:app --port 8000

# CORS. Set locally for the same reason it is set in production: with hosting
# markers present (PORT is one) and an empty allowlist, the backend refuses to
# start. That guard catches a deploy that passes every health check while
# blocking every browser request. Leaving this empty in development would mean
# local startup takes a different path from the one that matters.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# Explanations are served from the pre-generated, guard-checked store.
# No API key, no outbound call.
EXPLANATION_MODE=static

# JDK 17 satisfies both PharmCAT (needs 17+) and the Android Gradle build
# (rejects 25). One JDK for both.
# JAVA_HOME=/opt/homebrew/opt/openjdk@17   # adjust to your JDK 17 path
