# PharmaGuard backend — environment template.
# Copy to `.env` and fill in. Nothing here is required for the deployed path.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit a real key.

# --- Explanations -----------------------------------------------------------
# static   (default, deployed) serve pre-generated, guard-checked explanations.
#          No API call, no key. This is what production runs.
# live     call Gemini per request, then the faithfulness guard. For the demo
#          video only. Needs GEMINI_API_KEY and `pip install -r requirements-llm.txt`.
# template deterministic composition only.
EXPLANATION_MODE=static

# --- Optional: live mode / offline pre-generation ----------------------------
# Only read when EXPLANATION_MODE=live, or by scripts/pregenerate_explanations.py
# with --generator llm. The deployed default makes no outbound network call.
# Free tier available at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Override the model id. Default is set in app/explanation/generator_llm.py
# (checked against ai.google.dev on 2026-07-22).
# GEMINI_MODEL=gemini-3.6-flash

# --- Paths (usually auto-detected) ------------------------------------------
# Where the mechanism corpus lives. Set in the Docker image because the
# container layout differs from the repo layout.
# PHARMAGUARD_CORPUS_DIR=/opt/pharmaguard/rag-corpus/mechanisms

# Where guard violations are appended as JSONL.
# GUARD_LOG_PATH=logs/guard_violations.jsonl

# --- PharmCAT ---------------------------------------------------------------
# PHARMCAT_PIPELINE=pharmcat_pipeline
# PHARMCAT_TIMEOUT_SECONDS=120

# --- Deployment (Phase 4) ----------------------------------------------------
# Exact origins allowed to call this API from a browser, comma-separated.
# NO WILDCARD. localhost is always allowed for development.
# Leave empty for local dev; set it on the deployed backend.
# CORS_ALLOWED_ORIGINS=https://pharmaguard.pages.dev

# Cloudflare Pages project name, to also allow its per-branch preview
# subdomains (<hash>.<project>.pages.dev). Scoped to one project — never
# a blanket *.pages.dev, which any attacker could deploy under.
# CORS_ALLOW_PAGES_PREVIEWS=pharmaguard

# Per-client rate limit on /analyze. Each analysis spawns a JVM, so an
# unlimited public endpoint would burn a free tier's compute budget.
# RATE_LIMIT_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=300

# Injected by Cloud Run and Render. The container falls back to 7860
# (the Hugging Face Spaces convention) when unset.
# PORT=8080
